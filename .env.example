# Deployment (run by whoever deploys the factory — protocol side)
DEPLOYER_PRIVATE_KEY=
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
NETWORK_NAME=xlayerTestnet

# Which network the bot talks to at runtime: 1952 (testnet) or 196 (mainnet)
CHAIN_ID=1952

# Bot
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
PORT=3000

# Chain-side agent signer (the session key the bot uses to call executeTrade —
# distinct from any user's own wallet). Fund this with a small amount of gas
# token only; it should never hold user funds.
AGENT_SIGNER_PRIVATE_KEY=
AGENT_SIGNER_ADDRESS=

# OKX DEX aggregator API (web3.okx.com developer portal) — required for
# get_quote / execute_trade / rules engine to actually price and build swaps.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
