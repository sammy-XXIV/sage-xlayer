# Deployment (run by whoever deploys the factory — protocol side)
DEPLOYER_PRIVATE_KEY=
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
NETWORK_NAME=xlayerTestnet

# Free key from oklink.com (My Account -> API Management) — used only for
# `npx hardhat okverify` to verify contract source on the X Layer explorer.
OKLINK_API_KEY=

# Which network the bot talks to at runtime: 1952 (testnet) or 196 (mainnet)
CHAIN_ID=1952

# Bot
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
PORT=3000

# --- Persistence -----------------------------------------------------------
# Set BOTH of these to use Supabase (recommended for any real deployment).
# Run supabase/schema.sql once in the Supabase SQL editor first.
# SUPABASE_SERVICE_KEY is the service_role key, not the anon key: it's used
# server-side only and deliberately bypasses RLS. Never ship it to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Only used when Supabase is NOT configured — the local JSON fallback. Point it
# at a mounted volume, or state is wiped on every redeploy of an ephemeral host.
DATA_DIR=

# Chain-side agent signer (the session key the bot uses to call executeTrade —
# distinct from any user's own wallet). Fund this with a small amount of gas
# token only; it should never hold user funds.
AGENT_SIGNER_PRIVATE_KEY=
AGENT_SIGNER_ADDRESS=

# OKX DEX aggregator API (web3.okx.com developer portal) — required for
# get_quote / execute_trade / rules engine to actually price and build swaps.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Max % of vault value the agent will let a single asset reach before
# warning and requiring explicit confirmation (see bot/tools/portfolioRisk.js).
MAX_CONCENTRATION_PERCENT=60

# OpenAI key for Whisper transcription of Telegram voice messages.
# Voice trading falls back to a clear error if this isn't set.
OPENAI_API_KEY=
